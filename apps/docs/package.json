{
    "name": "@bimorph/docs",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "bimorph documentation site — Fumadocs (Next.js App Router) with twoslash-checked examples against the real bimorph types.",
    "scripts": {
        "dev": "next dev -p 3411",
        "build": "fumadocs-mdx && next build",
        "start": "next start",
        "check:types": "fumadocs-mdx && next typegen && tsc --noEmit",
        "gen:docs": "node scripts/generate-skeleton.mjs",
        "postinstall": "fumadocs-mdx"
    },
    "dependencies": {
        "bimorph": "file:../..",
        "fumadocs-core": "^16.10.0",
        "fumadocs-mdx": "^15.0.12",
        "fumadocs-twoslash": "^3.2.0",
        "fumadocs-typescript": "^5.2.6",
        "fumadocs-ui": "^16.10.0",
        "lucide-react": "^1.17.0",
        "next": "16.2.7",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "tailwind-merge": "^3.6.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "@types/mdx": "^2.0.13",
        "@types/node": "^25.9.1",
        "@types/react": "^19.2.16",
        "@types/react-dom": "^19.2.3",
        "postcss": "^8.5.15",
        "shiki": "4.2.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3"
    }
}
